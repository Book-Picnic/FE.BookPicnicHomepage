---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const works = [
  {
    title: '문해내공',
    credit: '신종호, 김윤정 공동 저술',
    note: 'AI 시대에도 흔들리지 않는 읽기와 이해의 힘을 다룹니다.',
    href: 'https://www.aladin.co.kr/shop/wproduct.aspx?ItemId=398761872',
  },
  {
    title: 'EBS 당신의 문해력',
    credit: 'EBS 제작팀 기획, 김윤정 글',
    note: '방송의 연구와 현장을 부모와 아이의 언어로 풀었습니다.',
    href: 'https://www.aladin.co.kr/shop/wproduct.aspx?ItemId=314833144',
  },
  {
    title: '공부머리 만드는 초등 문해력 수업',
    credit: '김윤정 저',
    note: '초등 시기에 필요한 문해력의 기초와 실천을 안내합니다.',
    href: 'https://www.aladin.co.kr/shop/wproduct.aspx?ItemId=278393799',
  },
  {
    title: '초등 글쓰기 수업',
    credit: '김윤정 저',
    note: '읽은 생각을 자기 문장으로 완성하는 과정을 담았습니다.',
    href: 'https://www.aladin.co.kr/shop/wproduct.aspx?ItemId=289020379',
  },
];

const method = [
  ['읽기', '한 권을 끝내는 데 그치지 않고 중심 문장과 장면을 천천히 발견합니다.'],
  ['질문', '정답을 확인하기보다 왜 그런지, 나는 어떻게 생각하는지 묻습니다.'],
  ['토론', '서로 다른 생각을 듣고 자기 의견의 근거를 또렷하게 만듭니다.'],
  ['글쓰기', '떠오른 생각을 순서 있게 정리해 자기 언어로 씁니다.'],
  ['발표', '쓴 글을 소리 내어 전하며 표현의 자신감을 기릅니다.'],
  ['개별 피드백', '아이의 문장을 존중하면서 다음 문장으로 나아갈 방법을 함께 찾습니다.'],
];

const programs = [
  {
    title: '초등 글쓰기',
    summary: '읽은 내용을 이해하고 생각을 문장으로 정리하는 기본 과정',
    detail: '책을 읽은 뒤 핵심을 찾고, 질문하고, 글의 순서를 세웁니다. 아이마다 다른 문장을 살펴보며 개별 피드백을 제공합니다.',
  },
  {
    title: '고학년 독서 표현',
    summary: '깊이 읽고 토론하며 자기 관점을 분명히 만드는 과정',
    detail: '수렴적 사고와 발산적 사고를 함께 사용합니다. 질문, 토론, 감상문, 발표를 연결해 생각을 논리적으로 표현합니다.',
  },
  {
    title: '부모 책대화',
    summary: '부모와 아이가 한 권의 책으로 오래 대화하는 방법',
    detail: '책의 권수보다 대화의 깊이에 집중합니다. 부모가 아이의 말에 귀 기울이고 좋은 질문을 이어 가도록 돕습니다.',
  },
];
---

<BaseLayout
  title="책나들이 | 김윤정의 독서와 글쓰기 교육"
  description="책을 읽고, 생각을 나누고, 자기 언어로 표현하는 힘. 저자, 북에디터, 교육자 김윤정의 책나들이입니다."
>
  <Header />

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span class="hero-line">책을 읽고,</span>
          <span class="hero-line">생각을 나누고,</span>
          <span class="hero-line">자기 언어로</span>
          <span class="hero-line">표현하는 힘</span>
        </h1>
        <p class="hero-description">김윤정 대표와 함께 읽고, 질문하고, 쓰는 시간</p>
        <div class="hero-actions">
          <a class="button button-primary" href="https://www.instagram.com/gogo_bookpicnic/" target="_blank" rel="noreferrer">
            <i class="ph ph-instagram-logo" aria-hidden="true"></i>
            <span>Instagram DM으로 문의</span>
            <i class="ph ph-arrow-up-right button-arrow" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="tel:+821034148609">
            <i class="ph ph-phone" aria-hidden="true"></i>
            <span>전화 문의</span>
            <i class="ph ph-arrow-up-right button-arrow" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-portrait" aria-hidden="true">
        <picture>
          <source media="(max-width: 767px)" srcset="/images/profile/kim-yoonjung-hero-760.avif" type="image/avif" />
          <source media="(max-width: 767px)" srcset="/images/profile/kim-yoonjung-hero-760.webp" type="image/webp" />
          <source srcset="/images/profile/kim-yoonjung-hero-1280.avif" type="image/avif" />
          <img
            src="/images/profile/kim-yoonjung-hero-1280.webp"
            width="1280"
            height="1600"
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </section>

    <section class="about section" id="about" aria-labelledby="about-title">
      <div class="section-inner about-grid">
        <div class="about-statement" data-reveal>
          <p class="eyebrow">한 사람의 전문성</p>
          <h2 id="about-title">책을 만들고 가르쳐 온 시간이 한 사람의 수업으로 이어집니다.</h2>
        </div>
        <div class="about-body" data-reveal>
          <p>김윤정 대표는 20년 넘게 책을 만들어 온 편집자이자 작가입니다. 어린이책을 기획하고 편집한 경험을 바탕으로 아이들과 읽고, 질문하고, 씁니다.</p>
          <div class="role-list" aria-label="김윤정 대표의 전문 영역">
            <span>저자</span>
            <span>북에디터</span>
            <span>교육자</span>
          </div>
        </div>
      </div>
    </section>

    <section class="works section" id="works" aria-labelledby="works-title">
      <div class="section-inner">
        <div class="section-heading" data-reveal>
          <h2 id="works-title">읽고 쓰는 힘을 책으로 전합니다.</h2>
          <p>문해력과 글쓰기를 연구하고, 부모와 아이가 실천할 수 있는 언어로 풀어냈습니다.</p>
        </div>
        <div class="works-grid">
          {works.map((work, index) => (
            <a class:list={['work-item', { featured: index === 0 }]} href={work.href} target="_blank" rel="noreferrer" data-reveal>
              <div>
                <p class="work-credit">{work.credit}</p>
                <h3>{work.title}</h3>
                <p>{work.note}</p>
              </div>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy section" aria-labelledby="philosophy-title">
      <div class="section-inner philosophy-layout">
        <div class="philosophy-line" data-reveal aria-hidden="true"></div>
        <div data-reveal>
          <h2 id="philosophy-title">많이 읽는 것보다, 좋아하며 질문하고 표현하는 독서</h2>
          <p>문해력은 문제를 푸는 기술에 머물지 않습니다. 세상을 이해하고 자기 삶을 선택하는 힘입니다. 책나들이는 한 권의 책에서 아이의 경험과 생각이 이어지도록 돕습니다.</p>
        </div>
      </div>
    </section>

    <section class="method section" id="method" aria-labelledby="method-title">
      <div class="section-inner method-layout">
        <div class="method-intro">
          <p class="eyebrow">수업의 흐름</p>
          <h2 id="method-title">생각이 문장이 될 때까지</h2>
          <p>한 번의 활동으로 끝내지 않고 읽기에서 표현까지 차근차근 연결합니다.</p>
          <div class="method-progress" aria-hidden="true"><span data-method-progress></span></div>
        </div>

        <ol class="method-steps">
          {method.map(([title, description], index) => (
            <li class="method-step" data-method-step data-step={index + 1}>
              <span class="method-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="programs section" id="programs" aria-labelledby="programs-title">
      <div class="section-inner">
        <div class="section-heading" data-reveal>
          <h2 id="programs-title">아이와 부모의 자리에서 시작합니다.</h2>
          <p>수업 내용과 아이에게 적합한 방향은 Instagram DM으로 안내합니다.</p>
        </div>
        <div class="program-list" data-program-list>
          {programs.map((program, index) => (
            <div class:list={['program-item', { 'is-open': index === 0 }]} data-reveal>
              <button
                class="program-toggle"
                type="button"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`program-panel-${index + 1}`}
              >
                <span class="program-title">{program.title}</span>
                <span class="program-summary">{program.summary}</span>
                <i class="ph ph-plus" aria-hidden="true"></i>
              </button>
              <div
                class="program-detail"
                id={`program-panel-${index + 1}`}
                aria-hidden={index === 0 ? 'false' : 'true'}
              ><p>{program.detail}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="book-talk section" id="book-talk" aria-labelledby="book-talk-title">
      <div class="section-inner book-talk-layout">
        <div class="book-talk-title" data-reveal>
          <p class="eyebrow">오늘의 책대화</p>
          <h2 id="book-talk-title">한 권의 책이 대화가 되는 순간</h2>
        </div>
        <div class="book-talk-copy" data-reveal>
          <p>오늘의 책대화는 부모와 아이가 책으로 질문하고 마음을 나누는 콘텐츠 프로젝트입니다. 책의 줄거리보다 아이가 무엇을 느끼고 생각했는지 오래 듣습니다.</p>
          <a class="text-link" href="https://www.instagram.com/6a_space/" target="_blank" rel="noreferrer">
            @6a_space에서 책대화 보기
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <section class="collaboration section" aria-labelledby="collaboration-title">
      <div class="section-inner collaboration-layout">
        <div data-reveal>
          <h2 id="collaboration-title">강연과 출판 협업도 함께합니다.</h2>
          <p>문해력, 독서교육, 부모 책대화를 주제로 한 기관 강연과 출판 협업을 진행합니다.</p>
        </div>
        <a class="text-link" href="https://www.instagram.com/gogo_bookpicnic/" target="_blank" rel="noreferrer" data-reveal>
          협업 문의하기
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <section class="contact section" id="contact" aria-labelledby="contact-title">
      <div class="section-inner contact-layout" data-reveal>
        <div>
          <h2 id="contact-title">아이의 읽기와 쓰기, 어디서 시작할지 함께 이야기해요.</h2>
          <p>공식 문의는 Instagram DM을 먼저 이용해 주세요.</p>
        </div>
        <div class="contact-actions">
          <a class="button button-primary" href="https://www.instagram.com/gogo_bookpicnic/" target="_blank" rel="noreferrer">
            <i class="ph ph-instagram-logo" aria-hidden="true"></i>
            <span>Instagram DM으로 문의</span>
            <i class="ph ph-arrow-up-right button-arrow" aria-hidden="true"></i>
          </a>
          <a class="contact-phone" href="tel:+821034148609">010-3414-8609</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-inner footer-layout">
      <a class="brand footer-brand" href="#top" aria-label="책나들이 맨 위로">
        <span class="brand-ko">책나들이</span>
        <span class="brand-en">BOOKPICNIC</span>
      </a>
      <p>저자, 북에디터, 교육자 김윤정</p>
      <p>© 2026 책나들이</p>
    </div>
  </footer>

  <script>
    const body = document.body;
    const menuButton = document.querySelector('[data-menu-button]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const menuIcon = menuButton?.querySelector('i');

    requestAnimationFrame(() => body.classList.add('is-ready'));

    const closeMenu = () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', '메뉴 열기');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      mobileMenu?.classList.remove('is-open');
      menuIcon?.classList.remove('ph-x');
      menuIcon?.classList.add('ph-list');
      body.classList.remove('menu-open');
    };

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
        return;
      }
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', '메뉴 닫기');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      mobileMenu?.classList.add('is-open');
      menuIcon?.classList.remove('ph-list');
      menuIcon?.classList.add('ph-x');
      body.classList.add('menu-open');
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
    );

    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));

    const steps = [...document.querySelectorAll('[data-method-step]')];
    const progress = document.querySelector<HTMLElement>('[data-method-progress]');
    const methodObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          steps.forEach((step) => step.classList.remove('is-active'));
          entry.target.classList.add('is-active');
          const index = Number(entry.target.getAttribute('data-step'));
          progress?.style.setProperty('--method-progress', String(index / steps.length));
        });
      },
      { threshold: 0.62 },
    );

    steps.forEach((step) => methodObserver.observe(step));

    const programItems = [...document.querySelectorAll<HTMLElement>('[data-program-list] .program-item')];
    programItems.forEach((item) => {
      item.querySelector<HTMLButtonElement>('.program-toggle')?.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');
        programItems.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.program-toggle')?.setAttribute('aria-expanded', 'false');
          other.querySelector('.program-detail')?.setAttribute('aria-hidden', 'true');
        });
        if (!willOpen) return;
        item.classList.add('is-open');
        item.querySelector('.program-toggle')?.setAttribute('aria-expanded', 'true');
        item.querySelector('.program-detail')?.setAttribute('aria-hidden', 'false');
      });
    });
  </script>
</BaseLayout>
